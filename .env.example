# Configure in Vercel, never in browser code.
SUPABASE_URL=https://xyaykxkytjnzykcjkopj.supabase.co
SUPABASE_ANON_KEY=your_public_project_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
GEMINI_API_KEY=your_server_only_gemini_key
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
# Optional alternate model; defaults to retrying the primary model.
GEMINI_FALLBACK_MODEL=
RATE_LIMIT_SALT=replace_with_a_random_secret
# Public widget key, embedded by the build. Secret stays exclusively on server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional exact additional origins, comma-separated. No wildcard preview domains.
ALLOWED_ORIGINS=
